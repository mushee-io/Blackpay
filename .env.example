# Public client configuration only. Never place witness values, salary data,
# salts, funded-coin capabilities, mnemonics, seeds, or private keys in
# NEXT_PUBLIC_* variables.
NEXT_PUBLIC_MIDNIGHT_NETWORK=preview

# Optional public default after a real Blackpay protocol-v2 contract has been
# deployed. Leave blank before the canonical v2 Preview deployment exists.
NEXT_PUBLIC_BLACKPAY_CONTRACT_ADDRESS=

# Optional default payroll token type. The employer UI reads real shielded
# balances from Lace and can select a raw 32-byte token type at runtime.
NEXT_PUBLIC_PAYROLL_TOKEN_TYPE=

# Do not configure public proof-server, indexer, websocket, or node URLs here.
# Blackpay uses the connected Lace wallet's getConfiguration() endpoints and
# delegated proving provider so the user's wallet-selected infrastructure is
# honored.
