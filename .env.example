# Public client configuration only. Never place witness values, salary data,
# salts, mnemonics, seeds, or private keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_MIDNIGHT_NETWORK=preview
NEXT_PUBLIC_MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
NEXT_PUBLIC_MIDNIGHT_INDEXER_URL=
NEXT_PUBLIC_MIDNIGHT_INDEXER_WS_URL=
NEXT_PUBLIC_MIDNIGHT_NODE_URL=
NEXT_PUBLIC_BLACKPAY_CONTRACT_ADDRESS=

# Token type to use for payroll outputs. Configure this only when a real
# supported token is available on the selected Midnight environment.
NEXT_PUBLIC_PAYROLL_TOKEN_TYPE=
